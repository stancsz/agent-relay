{
  "version": 1,
  "enabled": true,
  "default_action": "continue",
  "profiles": {
    "high_planner": {
      "lane": "codex-escalation",
      "model": "gpt-5.6-sol",
      "reasoning_effort": "high",
      "role": "planner"
    },
    "high_verifier": {
      "lane": "codex-review",
      "model": "gpt-5.6-sol",
      "reasoning_effort": "high",
      "role": "verifier"
    }
  },
  "rules": [
    {
      "id": "critical-authority",
      "priority": 1000,
      "stages": ["plan_end", "execute", "review_end", "recovery", "release"],
      "any": {
        "risk_flags": ["credentials", "production", "destructive"],
        "consequence": ["critical"]
      },
      "action": "block",
      "evidence_required": ["explicit_authority"]
    },
    {
      "id": "hard-plan",
      "priority": 900,
      "stages": ["plan_end"],
      "any": {
        "task_kind": ["architecture", "security", "migration", "product_decision", "ambiguous"],
        "ambiguity": true,
        "consequence": ["high", "critical"]
      },
      "action": "consult",
      "profile": "high_planner",
      "evidence_required": ["assumptions", "alternatives", "risks", "acceptance_criteria"]
    },
    {
      "id": "repeated-failure",
      "priority": 750,
      "stages": ["recovery"],
      "any": {
        "worker_failed": true,
        "verification_failed": true,
        "attempts_at_least": 2
      },
      "action": "consult",
      "profile": "high_planner",
      "evidence_required": ["failure_history", "attempted_remedies", "recovery_plan"]
    },
    {
      "id": "proof-review",
      "priority": 700,
      "stages": ["review_end", "release"],
      "any": {
        "verification_failed": true,
        "missing_evidence": true,
        "scope_changed": true,
        "risk_flags": ["security", "architecture", "production"]
      },
      "action": "require_review",
      "profile": "high_verifier",
      "evidence_required": ["independent_findings", "verification_receipt"],
      "max_revisions": 1,
      "on_reject": "revise",
      "on_exhausted": "human_review"
    },
    {
      "id": "plan-end-second-opinion",
      "priority": 950,
      "stages": ["plan_end"],
      "action": "consult",
      "profile": "high_planner",
      "evidence_required": ["plan_feedback", "assumptions", "risks"],
      "max_revisions": 1,
      "on_reject": "revise",
      "on_exhausted": "human_review"
    },
    {
      "id": "review-end-second-opinion",
      "priority": 800,
      "stages": ["review_end"],
      "action": "require_review",
      "profile": "high_verifier",
      "evidence_required": ["independent_findings", "verification_receipt"],
      "max_revisions": 1,
      "on_reject": "revise",
      "on_exhausted": "human_review"
    }
  ],
  "default_gates": {
    "plan_end": "high_planner",
    "review_end": "high_verifier"
  }
}
